# ─────────────────────────────────────────────
#  local-ai-suite — configurazione ambiente
# ─────────────────────────────────────────────
#  Copia questo file in .env e personalizzalo
#  cp .env.example .env
# ─────────────────────────────────────────────

# Modello primario per Claude Code (agente) o Llama Server (Unsloth)
PRIMARY_MODEL=Qwen3.5-9B-Q4_K_M.gguf

# Modello per autocomplete VS Code (Continue.dev)
AUTOCOMPLETE_MODEL=

# Modello per embeddings (Continue.dev RAG)
EMBEDDING_MODEL=

# Context window (max raccomandato 32768 per 16GB RAM)
LLAMA_CONTEXT_LENGTH=32768

# Endpoint Llama Server
LLAMA_SERVER_URL=http://127.0.0.1:8080/v1

# Cartella del tuo progetto da aprire con VS Code
# Lascia vuoto per aprire la directory corrente
WORKSPACE_PATH=

# Auto-update: controlla aggiornamenti all'avvio (true/false)
AUTO_UPDATE=true

# Livello di log dello script (info | debug | quiet)
LOG_LEVEL=info
