# ─────────────────────────────────────────────
#  local-ai-suite — configurazione ambiente
# ─────────────────────────────────────────────
#  Copia questo file in .env e personalizzalo
#  cp .env.example .env
# ─────────────────────────────────────────────

# Modello primario per Claude Code (agente)
PRIMARY_MODEL=qwen2.5:14b-instruct-q4_K_M

# Modello per autocomplete VS Code (Continue.dev) — può essere più leggero
AUTOCOMPLETE_MODEL=qwen2.5-coder:7b-instruct

# Modello per embeddings (Continue.dev RAG)
EMBEDDING_MODEL=nomic-embed-text:latest

# Context window (min 32k per Claude Code, max raccomandato 32k per 16GB RAM)
OLLAMA_CONTEXT_LENGTH=32768

# Host Ollama
OLLAMA_HOST=http://localhost:11434

# Cartella del tuo progetto da aprire con VS Code
# Lascia vuoto per aprire la directory corrente
WORKSPACE_PATH=

# Auto-update: controlla aggiornamenti all'avvio (true/false)
AUTO_UPDATE=true

# Livello di log dello script (info | debug | quiet)
LOG_LEVEL=info
